# --- Telegram (required unless --dry-run) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=            # @channelname or -100...

# --- Scan ---
# breakout = OI and price both rising (catch the move in progress)
# premove  = OI rising while price stays flat (catch it before expansion)
# both     = run the two together; they share one OI fetch, so no extra API cost
MODE=breakout
EXCHANGES=binance,bybit      # add mexc,bitget once snapshot history accrues
WINDOW_MINUTES=60
SCAN_INTERVAL_MIN=10         # must be <= half the shortest active window
CONCURRENCY=8

# --- Gates ---
MIN_VOLUME=10000000          # 24h quote volume, USD
MIN_OI_DELTA=5               # % OI rise over the window
MAX_PCHG_24H=40              # skip names that already ran

# --- Pre-move gates (MODE=premove or both) ---
PREMOVE_WINDOW_MINUTES=15    # shorter window: the thesis is a fast OI commit
PREMOVE_MIN_OI_DELTA=3       # % OI rise over the pre-move window
PREMOVE_MAX_ABS_PCHG_WINDOW=1.5  # MAXIMUM move over the WINDOW — quiet right now
PREMOVE_MAX_ABS_PCHG_24H=12  # MAXIMUM move over the DAY — hasn't already gone.
                             # Deliberately far tighter than MAX_PCHG_24H=40:
                             # a coin +35% today that goes flat for 15m is late
                             # longs into a topped move, not anticipation.
PREMOVE_MIN_SCORE=0.35       # score floor; pre-move ranks looser gates, so it needs one

# --- Pre-move weights ---
# The price term is INVERTED here: a flat tape scores 1, a moving tape scores 0.
# That is why pre-move cannot share the breakout weight set.
PM_W_OI=0.40
PM_W_VOL=0.15
PM_W_QUIET=0.30

# --- Alerting ---
ALERT_COOLDOWN_MIN=60
ALERT_ON_VENUE_SPREAD=true   # re-alert mid-cooldown when a NEW exchange confirms
MAX_ALERTS=10

# --- Scoring tunables ---
W_OI=0.45
W_VOL=0.20
W_PRICE=0.25
W_FUNDING=0.15
CROSS_BONUS=0.15             # per extra exchange, capped below
CROSS_BONUS_MAX_EXTRA=2
NORM_OI_MAX=25               # OI % rise that maxes the OI term
NORM_VOL_FLOOR=10000000      # volume mapping to 0
NORM_VOL_DECADES=2           # decades above the floor mapping to 1 (10M->0, 1B->1)
NORM_PRICE_WINDOW_MAX=10
NORM_PRICE_24H_MAX=40
NORM_FUNDING_MAX=0.001

# --- Misc ---
SNAPSHOT_MAX_STALENESS_MIN=0   # 0 = auto (2 scan intervals, min 15m)
PRICE_REF_STALENESS_MIN=0      # 0 = auto (1.5 scan intervals, min 5m).
                               # Tighter than the OI allowance: a 15m "price is
                               # flat" verdict is meaningless off a 30m-old reference.
TRACK_OUTCOMES=true            # score every alert forward at +15m/+1h/+4h (no API cost)

# --- Network ---
# Resolve through these servers instead of the system resolver. Set this when
# your ISP NXDOMAINs the exchange APIs (the hosts themselves still answer).
# Empty = system DNS.
DNS_SERVERS=1.1.1.1,8.8.8.8

# Base URLs — override to route around a blocking ISP.
# Bybit publishes an official mirror that is often reachable when the main one is not:
# BYBIT_BASE_URL=https://api.bytick.com

# Relative paths resolve inside the container on a hosted deploy and are wiped
# on every redeploy. On Railway leave this UNSET (the Dockerfile points it at
# the volume) or set it to an absolute path under the mount, /data/oi-scanner.db.
DB_PATH=./oi-scanner.db
HTTP_TIMEOUT_MS=15000
